# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://aksioma:secret@localhost:5432/aksioma_db"

# ── Redis ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_THIS_REFRESH_SECRET_TOO"
JWT_REFRESH_EXPIRES_IN="7d"

# ── SMS / OTP (Twilio) ────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxx"

# ── Cloudinary (Phase 2) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── App ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ── ERP integration ───────────────────────────────────
# Provider selector. "stub" = preserved Phase-3 stub (no real ERP calls).
# "wolvox" = Akınsoft Wolvox SDK XML over HTTP. To revert from Wolvox,
# set this back to "stub" or remove it.
ERP_PROVIDER="stub"

# --- Used only when ERP_PROVIDER=stub ---
# (Original placeholders kept for backward compatibility.)
ERP_BASE_URL=""
ERP_API_KEY=""

# --- Used only when ERP_PROVIDER=wolvox ---
# Wolvox SDK only speaks plain HTTP — do NOT use https:// (per SDK doc).
# Default port is 3056; ensure it's reachable through any firewall.
ERP_HOST="http://192.168.1.10"
ERP_PORT="3056"
ERP_DEV_CODE=""
ERP_DEV_PASSWORD=""
ERP_COMPANY_CODE="1"
ERP_BRANCH_CODE=""
# IMPORTANT: must match the active fiscal year in Wolvox; getting this wrong
# writes data into a closed accounting period (see SDK doc on "Devir İşlemleri").
ERP_WORKING_YEAR="2026"
# Optional: which command to call (default get_stokenvanter — full inventory).
ERP_COMMAND="get_stokenvanter"
# Optional: HTTP timeout in ms.
ERP_TIMEOUT_MS="60000"
# Fallbacks when the row doesn't carry these.
ERP_DEFAULT_CATEGORY_SLUG="yazi-gerecleri"
ERP_DEFAULT_UNIT_CODE="adet"
# Optional XML field-name overrides (comma-separated, tried before defaults).
# Inspect a failed sync's errorLog to see the raw row, then adjust here.
# ERP_FIELD_NAME="STOK_ADI"
# ERP_FIELD_SKU="STOK_KODU"
# ERP_FIELD_BARCODE="BARKODU"
# ERP_FIELD_STOCK_QTY="MIKTARI"
# ERP_FIELD_UNIT="BIRIM"
# ERP_FIELD_CATEGORY="GRUBU"
# ERP_FIELD_DESCRIPTION="ACIKLAMA"
# ERP_FIELD_PRICE_STD="SATISFIYATI1"
# ERP_FIELD_PRICE_FAV="SATISFIYATI2"
# ERP_FIELD_PRICE_SPC="SATISFIYATI3"
